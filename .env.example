# Copy to .env and fill in. Never commit real secrets.
# Used by the example backend / playground (Phase 7+); the published
# packages themselves require no configuration.

# PostgreSQL (Drizzle, example backend)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trpc_mcp_playground

# Redis (BullMQ, Socket.IO adapter, rate limiting)
REDIS_URL=redis://localhost:6379

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3001

# AI provider key for the playground chat panel
OPENAI_API_KEY=sk-replace-me

# OpenTelemetry OTLP endpoint for the observability demo
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

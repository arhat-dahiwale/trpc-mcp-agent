{
  "name": "trpc-mcp-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && prettier --check .",
    "format": "prettier --write .",
    "test": "turbo run test",
    "test:zod3": "node scripts/use-zod.mjs 3 && turbo run test",
    "test:zod4": "node scripts/use-zod.mjs 4 && turbo run test",
    "check:publish": "turbo run check:publish",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.10.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}

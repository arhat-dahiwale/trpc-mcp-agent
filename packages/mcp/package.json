{
  "name": "@trpc-mcp/mcp",
  "version": "0.1.0",
  "description": "MCP server adapter for tRPC routers: stdio and Streamable HTTP transports backed by @trpc-mcp/core.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:publish": "publint && attw --pack ."
  },
  "dependencies": {
    "@trpc-mcp/core": "workspace:*"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@trpc-mcp/core": "workspace:*",
    "@trpc/server": "11.23.0",
    "@types/node": "24.10.1",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "zod": "4.6.7",
    "@trpc-mcp/test-utils": "workspace:*"
  }
}
